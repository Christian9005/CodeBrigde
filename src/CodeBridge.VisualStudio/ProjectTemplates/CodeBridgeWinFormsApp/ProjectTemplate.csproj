<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- We will let the CodeBridge Installer handle the NuGet package if they use the Setup Window, 
       but for the template, we can't easily reference a local VSIX path for NuGet without a nuget.config. 
       So we'll create the project, and then recommend they open the CodeBridge Setup Tool Window! -->

</Project>
