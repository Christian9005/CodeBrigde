<UserControl x:Class="CodeBridge.VisualStudio.Editor.FlowNodeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="168" MinHeight="44"
             Cursor="Arrow">
    <UserControl.Resources>
        <SolidColorBrush x:Key="VsNodeBackground" Color="#252526"/>
        <SolidColorBrush x:Key="VsNodeHeader" Color="#2d2d30"/>
        <SolidColorBrush x:Key="VsNodeBorder" Color="#3f3f46"/>
        <SolidColorBrush x:Key="VsNodeText" Color="#f1f1f1"/>
        <SolidColorBrush x:Key="VsGrayText" Color="#999999"/>
        <SolidColorBrush x:Key="VsNodeSelectedBorder" Color="#007acc"/>
    </UserControl.Resources>

    <Border x:Name="NodeBorder"
            BorderBrush="{StaticResource VsNodeBorder}"
            BorderThickness="1"
            CornerRadius="4"
            Background="{StaticResource VsNodeBackground}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.25" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource VsNodeHeader}"
                    CornerRadius="3,3,0,0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{StaticResource VsNodeBorder}">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Ellipse x:Name="CategoryIndicator" Width="8" Height="8" Fill="#007acc" Margin="0,0,8,0" />
                        <TextBlock x:Name="TitleText" Text="Node"
                                   Foreground="{StaticResource VsNodeText}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   FontSize="11" />
                    </StackPanel>
                    <Border x:Name="BadgeBorder" Background="#00d88f" CornerRadius="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" Padding="4,1">
                        <TextBlock x:Name="BadgeText" Text="OK" Foreground="White" FontSize="9" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Inputs -->
                <StackPanel x:Name="InputPortsPanel" Grid.Column="0" Margin="-6,0,0,0"/>
                <!-- Outputs -->
                <StackPanel x:Name="OutputPortsPanel" Grid.Column="1" Margin="0,0,-6,0"/>
            </Grid>

            <Border x:Name="SummaryBorder" Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource VsNodeBorder}" Padding="10,3" Visibility="Collapsed">
                <TextBlock x:Name="SummaryText" Foreground="{StaticResource VsGrayText}" FontSize="10" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
