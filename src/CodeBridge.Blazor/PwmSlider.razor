@inherits CodeBridgeComponentBase

<div class="cb-card">
    <div class="cb-row" style="justify-content:space-between">
        <span class="cb-title">@(Label ?? $"PWM {Pin}")</span>
        <span class="cb-value" style="font-size:18px">@_duty</span>
    </div>
    <input class="cb-range" type="range" min="0" max="255" value="@_duty" aria-label="@(Label ?? $"PWM {Pin}")"
           @onchange="OnChangeAsync" />
    <div class="cb-muted">pin @Pin · @(_duty * 100 / 255)% duty</div>
    @if (Error is not null)
    {
        <div class="cb-error">@Error</div>
    }
</div>

@code {
    /// <summary>A PWM-capable GPIO (LED brightness, motor speed...).</summary>
    [Parameter, EditorRequired] public int Pin { get; set; }

    [Parameter] public string? Label { get; set; }

    [Parameter] public int FrequencyHz { get; set; } = 5000;

    [Parameter] public EventCallback<int> OnChanged { get; set; }

    private int _duty;

    // "change" fires when the user releases the slider, so dragging does not flood the board with commands.
    private async Task OnChangeAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var duty))
            return;

        try
        {
            _duty = Math.Clamp(duty, 0, 255);
            await Board.WritePwmAsync(Pin, _duty, FrequencyHz);
            Error = null;
            await OnChanged.InvokeAsync(_duty);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
    }
}
